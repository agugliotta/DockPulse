FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dockpulse-agent ./cmd/dockpulse-agent

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata docker-cli docker-cli-compose
COPY --from=build /out/dockpulse-agent /usr/local/bin/dockpulse-agent
ENV DOCKPULSE_AGENT_LISTEN_ADDR=:9090
EXPOSE 9090
ENTRYPOINT ["dockpulse-agent"]

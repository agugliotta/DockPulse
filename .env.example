# Development all-in-one only. Proxmox deployments use deploy/control.env.example
# on the Server and deploy/agent.env.example on each Docker LXC.
# Generate with: openssl rand -base64 32
DOCKPULSE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Shared registration token. Generate with: openssl rand -hex 32
DOCKPULSE_BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_BOOTSTRAP_TOKEN
# Unique per agent. Generate with: openssl rand -hex 32
DOCKPULSE_AGENT_SECRET=REPLACE_WITH_RANDOM_AGENT_SECRET_AT_LEAST_32_CHARS
# Use 18080 when 8080 is already occupied (common in a development machine).
DOCKPULSE_CONTROL_PORT=8080
DOCKPULSE_AGENT_ID=lxc-101
DOCKPULSE_AGENT_NAME=docker-lxc-101
DOCKPULSE_READ_ONLY=true
# Compose paths must be visible inside the agent at the same absolute paths
# stored in com.docker.compose.project.working_dir.
DOCKPULSE_COMPOSE_ROOTS=/opt/stacks,/srv/compose
DOCKPULSE_STACKS_PATH=./examples/stacks
DOCKPULSE_COMPOSE_PATH=./examples/compose

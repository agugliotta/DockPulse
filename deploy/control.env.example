# DockPulse Server (control plane). Generate with: openssl rand -base64 32
# Pin to 0.2.2 for predictable rollback, or use latest to track the newest published release.
DOCKPULSE_VERSION=0.2.2
DOCKPULSE_UPDATE_VERSION=latest
DOCKPULSE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Shared registration token. Generate with: openssl rand -hex 32
DOCKPULSE_BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_BOOTSTRAP_TOKEN
DOCKPULSE_CONTROL_PORT=8080

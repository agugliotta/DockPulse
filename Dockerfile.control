FROM node:22-alpine AS web-build
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM golang:1.25-alpine AS go-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dockpulse-control ./cmd/dockpulse-control

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata wget && addgroup -S dockpulse && adduser -S -G dockpulse dockpulse
WORKDIR /app
COPY --from=go-build /out/dockpulse-control /usr/local/bin/dockpulse-control
COPY --from=web-build /src/web/build /app/web
RUN mkdir /data && chown dockpulse:dockpulse /data
USER dockpulse
ENV DOCKPULSE_DB_PATH=/data/dockpulse.db DOCKPULSE_WEB_DIR=/app/web DOCKPULSE_LISTEN_ADDR=:8080
EXPOSE 8080
ENTRYPOINT ["dockpulse-control"]
